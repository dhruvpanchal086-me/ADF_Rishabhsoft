{
	"name": "DF_OrdersCleaned",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Shopeazy_Orders",
						"type": "DatasetReference"
					},
					"name": "AllOrders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Shopeazy_SQL_Orders",
						"type": "DatasetReference"
					},
					"name": "LoadOrders",
					"description": "Truncate Table fact_orders"
				}
			],
			"transformations": [
				{
					"name": "CleanOrder",
					"description": "Removes Nulls"
				},
				{
					"name": "GrossProfit"
				},
				{
					"name": "FinalOrder"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderId as string,",
				"          CustomerId as string,",
				"          ProductId as string,",
				"          OrderDate as date 'yyyy-MM-dd',",
				"          Quantity as integer,",
				"          UnitPrice as integer,",
				"          Discount as double,",
				"          ShippingCost as integer,",
				"          PaymentMethod as string,",
				"          OrderStatus as string,",
				"          Region as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['orders/month=*/orders_*.csv']) ~> AllOrders",
				"AllOrders filter((!isNull(OrderId))) ~> CleanOrder",
				"CleanOrder derive({Gross Revenue} = Quantity*UnitPrice,",
				"          {Discount Amount} = Quantity*UnitPrice*Discount,",
				"          NetRevenue = Quantity*UnitPrice*(1-Discount),",
				"          TotalRevenue = (Quantity*UnitPrice*(1-Discount)+ShippingCost),",
				"          IsDelivered = equals(OrderStatus,'Delivered'),",
				"          OrderYear = year(OrderDate),",
				"          OrderMonth = month(OrderDate)) ~> GrossProfit",
				"GrossProfit select(mapColumn(",
				"          OrderId,",
				"          CustomerId,",
				"          ProductId,",
				"          OrderDate,",
				"          Quantity,",
				"          UnitPrice,",
				"          DiscountPct = Discount,",
				"          ShippingCost,",
				"          PaymentMethod,",
				"          OrderStatus,",
				"          Region,",
				"          {Gross Revenue},",
				"          {Discount Amount},",
				"          NetRevenue,",
				"          TotalRevenue,",
				"          IsDelivered,",
				"          OrderYear,",
				"          OrderMonth",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> FinalOrder",
				"FinalOrder sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          OrderId as string,",
				"          CustomerId as string,",
				"          ProductId as string,",
				"          CustomerName as string,",
				"          ProductName as string,",
				"          Category as string,",
				"          OrderDate as date,",
				"          OrderMonth as integer,",
				"          OrderYear as integer,",
				"          Quantity as integer,",
				"          UnitPrice as decimal(10,2),",
				"          DiscountPct as decimal(5,2),",
				"          DiscountAmount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          ShippingCost as decimal(10,2),",
				"          NetRevenue as decimal(10,2),",
				"          CostOfGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          PaymentMethod as string,",
				"          OrderStatus as string,",
				"          IsDelivered as boolean,",
				"          Region as string,",
				"          LoadedAt as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     preSQLs:['Truncate table fact_Orders'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          OrderId,",
				"          CustomerId,",
				"          ProductId,",
				"          OrderDate,",
				"          OrderMonth,",
				"          OrderYear,",
				"          Quantity,",
				"          UnitPrice,",
				"          DiscountPct,",
				"          DiscountAmount = {Discount Amount},",
				"          GrossRevenue = {Gross Revenue},",
				"          ShippingCost,",
				"          NetRevenue,",
				"          PaymentMethod,",
				"          OrderStatus,",
				"          IsDelivered,",
				"          Region",
				"     )) ~> LoadOrders"
			]
		}
	}
}